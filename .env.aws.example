# =================================================================
# DDUK ERP AWS Deployment Environment Sample
# =================================================================
# Usage:
# 1. Copy this file to `.env.aws` on the EC2 host.
# 2. Replace every `replace_with_...` value before deployment.
# 3. Run: `docker compose --env-file .env.aws up -d --build`

# -----------------------------------------------------------------
# [COMMON]
# -----------------------------------------------------------------
APP_ENV=production
DEFAULT_TIMEZONE=Asia/Seoul

# -----------------------------------------------------------------
# [BACKEND - Spring Boot]
# -----------------------------------------------------------------
PORT=8080
DB_URL=jdbc:mysql://replace_with_tidb_host:4000/dduk_erp?useSSL=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=replace_with_tidb_user
DB_PASSWORD=replace_with_tidb_password
FRONTEND_PATH=classpath:/static/
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://replace_with_ec2_public_ip:*,https://replace_with_domain
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
SQL_INIT_MODE=always
SQL_INIT_CONTINUE_ON_ERROR=true
ACCOUNTING_SEED=true
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRATION=86400000
RPA_CALLBACK_TOKEN=replace_with_shared_callback_secret

# -----------------------------------------------------------------
# [AI SERVER - Flask]
# -----------------------------------------------------------------
AI_SERVER_PORT=5000
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------
# [RPA SERVER - Flask + Playwright]
# -----------------------------------------------------------------
RPA_SERVER_PORT=5050
RPA_BROWSER=chromium
RPA_HEADLESS=true
RPA_LOGIN_ID=replace_with_vendor_login_id_if_needed
RPA_LOGIN_PASSWORD=replace_with_vendor_login_password_if_needed
RPA_VENDOR_USERNAME=replace_with_vendor_portal_username
RPA_VENDOR_PASSWORD=replace_with_vendor_portal_password
DOWNLOAD_DIR=./outputs
PLAYWRIGHT_TIMEOUT_MS=30000
